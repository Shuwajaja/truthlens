# INACTIVE TEMPLATE. Host installation/activation needs separate owner authorization.
# Adapt paths and prepare trusted config/build/runtime directories before installation.
[Unit]
Description=TruthLens D34 fixed Shu read view (inactive example)
ConditionPathExists=/etc/truthlens/reader.json
ConditionPathIsDirectory=/srv/truthlens-published

[Service]
Type=simple
User=tl-reader
Group=tl-readers
UMask=0077
ExecStart=/opt/truthlens/venv/bin/python -m truthlens.read_service --config /etc/truthlens/reader.json
WorkingDirectory=/
Environment=PYTHONDONTWRITEBYTECODE=1
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/srv/truthlens-published /opt/truthlens
InaccessiblePaths=-/var/lib/truthlens -/etc/truthlens/audit.key
RestrictAddressFamilies=AF_INET
IPAddressDeny=any
IPAddressAllow=127.0.0.1/32
CapabilityBoundingSet=
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryMax=256M
TasksMax=16
StandardOutput=null
StandardError=null
# Loopback must be reachable by Shu's SSH forwarder. Worker exclusion requires
# separate reviewed UID/netns policy; this unit does not establish that policy.
# Agent Zero must NOT use this evidence-bearing listener. Its future dedicated
# Unix socket must expose status only and restrict access to its container UID.
# Intentionally no Install section: this template does not enable itself.
