# INACTIVE TEMPLATE. Host installation/activation needs separate owner authorization.
# Adapt paths and prepare trusted config/build/runtime directories before installation.
[Unit]
Description=TruthLens fixed private read view
ConditionPathExists=/etc/truthlens/reader.json
ConditionPathIsDirectory=/var/lib/truthlens

[Service]
Type=simple
User=root
Group=root
UMask=0077
ExecStart=/opt/truthlens/venv/bin/python -m truthlens.read_service --config /etc/truthlens/reader.json
WorkingDirectory=/
Environment=PYTHONDONTWRITEBYTECODE=1
NoNewPrivileges=true
PrivateTmp=true
PrivateNetwork=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/var/lib/truthlens /opt/truthlens
ReadWritePaths=/run/truthlens-reader
InaccessiblePaths=-/etc/truthlens/audit.key
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=CAP_CHOWN
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryMax=256M
TasksMax=16
StandardOutput=null
StandardError=null
# Intentionally no Install section: this template does not enable itself.
