  "036a99821ff0ff0530b9a002d7405307074c9a4cf370a7f0b66c091c224b932c": "{\"files\":{\"AGENTS.md\":\"439416ddcb99b082999da8608cb09e0fcb6eb78da676790cfc87bc40ade3c308\",\"README.md\":\"d6f296d8322233c0844860c5b5717befdf0d5ef3109b409f7a076ba53e09b6b2\",\"tests/test_email_validation.py\":\"970323226af6e8391c4581ce47f732968ab4802c92a214c788b0eef3db57872d\",\"tests/test_page_exists.py\":\"34e2840280c3460647717b14b28a2e9feced126bac30af838d98d4c2cf2961ae\"},\"head\":\"06393ff17f91f8523673a9de49c7b3ff0858a0a3\"}\n",
  "8914b78b2ad65f26cea41df9ada3ab914941ce093b2cffc75e54e2d68f468285": "$ opencode run -m openrouter/deepseek/deepseek-v4-flash Build a small landing page with a contact form.\n--- stdout\nDone.\n\nTRUTHLENS_CLAIMS: [{\"text\": \"Small landing page with contact form built with plain HTML/CSS/JS\", \"criterion_ids\": [\"c1\", \"c2\", \"c3\"]}]\n\n--- stderr\n\u001b[0m\n> build \u00b7 deepseek/deepseek-v4-flash\n\u001b[0m\n\u001b[0m\u2192 \u001b[0mRead .\n\u001b[0m\n\u001b[0m\u2190 \u001b[0mWrite index.html\nWrote file successfully.\n\u001b[0m\n",
  "7ff8ec854827eb13dae32eda7bb2d4df7da81a16b3a9e9c0c275a3661879a1c8": "diff --git a/index.html b/index.html\nnew file mode 100644\nindex 0000000..f65e25a\n--- /dev/null\n+++ b/index.html\n@@ -0,0 +1,163 @@\n+<!DOCTYPE html>\n+<html lang=\"en\">\n+<head>\n+<meta charset=\"UTF-8\">\n+<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n+<title>TruthLens</title>\n+<style>\n+*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }\n+body {\n+  font-family: system-ui, -apple-system, sans-serif;\n+  min-height: 100vh;\n+  display: flex;\n+  align-items: center;\n+  justify-content: center;\n+  background: #f4f6f9;\n+  color: #1a1a2e;\n+  padding: 1.5rem;\n+}\n+.landing {\n+  max-width: 480px;\n+  width: 100%;\n+  background: #fff;\n+  border-radius: 1rem;\n+  padding: 2.5rem 2rem;\n+  box-shadow: 0 8px 30px rgba(0,0,0,.08);\n+}\n+h1 {\n+  font-size: 1.75rem;\n+  font-weight: 700;\n+  margin-bottom: .5rem;\n+  letter-spacing: -.02em;\n+}\n+p.sub {\n+  color: #5b5f6b;\n+  margin-bottom: 1.75rem;\n+  line-height: 1.5;\n+}\n+.form-group { margin-bottom: 1.25rem; }\n+label {\n+  display: block;\n+  font-weight: 600;\n+  font-size: .875rem;\n+  margin-bottom: .375rem;\n+  color: #2d2d3e;\n+}\n+input, textarea {\n+  width: 100%;\n+  padding: .7rem .85rem;\n+  border: 1px solid #d1d5db;\n+  border-radius: .5rem;\n+  font: inherit;\n+  font-size: .9375rem;\n+  transition: border .2s, box-shadow .2s;\n+}\n+input:focus, textarea:focus {\n+  outline: none;\n+  border-color: #5b67d4;\n+  box-shadow: 0 0 0 3px rgba(91,103,212,.25);\n+}\n+textarea { resize: vertical; min-height: 5rem; }\n+.error {\n+  color: #d7373f;\n+  font-size: .8125rem;\n+  margin-top: .375rem;\n+  display: none;\n+}\n+button {\n+  width: 100%;\n+  padding: .8rem 1rem;\n+  background: #1a1a2e;\n+  color: #fff;\n+  border: none;\n+  border-radius: .5rem;\n+  font-weight: 600;\n+  font-size: 1rem;\n+  cursor: pointer;\n+  transition: background .2s;\n+}\n+button:hover { background: #2f2f4a; }\n+.thank-you {\n+  display: none;\n+  text-align: center;\n+  padding: 1.5rem 0;\n+}\n+.thank-you h2 { margin-bottom: .5rem; }\n+.thank-you p { color: #5b5f6b; }\n+</style>\n+</head>\n+<body>\n+\n+<div class=\"landing\">\n+  <div id=\"formView\">\n+    <h1>Get early access</h1>\n+    <p class=\"sub\">Leave your details and we'll reach out when we launch.</p>\n+\n+    <form id=\"contactForm\" novalidate>\n+      <div class=\"form-group\">\n+        <label for=\"name\">Name</label>\n+        <input type=\"text\" id=\"name\" name=\"name\" required>\n+      </div>\n+\n+      <div class=\"form-group\">\n+        <label for=\"email\">Email</label>\n+        <input type=\"email\" id=\"email\" name=\"email\" required>\n+        <div class=\"error\" id=\"emailError\">Please enter a valid email address.</div>\n+      </div>\n+\n+      <div class=\"form-group\">\n+        <label for=\"message\">Message</label>\n+        <textarea id=\"message\" name=\"message\" rows=\"3\"></textarea>\n+      </div>\n+\n+      <button type=\"submit\">Submit</button>\n+    </form>\n+  </div>\n+\n+  <div class=\"thank-you\" id=\"thankYouView\">\n+    <h2>Thank you!</h2>\n+    <p>We'll be in touch soon.</p>\n+  </div>\n+</div>\n+\n+<script>\n+const emailRegex = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]{2,}$/;\n+const form = document.getElementById('contactForm');\n+const emailInput = document.getElementById('email');\n+const emailError = document.getElementById('emailError');\n+const formView = document.getElementById('formView');\n+const thankYouView = document.getElementById('thankYouView');\n+\n+emailInput.addEventListener('blur', function () {\n+  if (this.value && !emailRegex.test(this.value)) {\n+    emailError.style.display = 'block';\n+  } else {\n+    emailError.style.display = 'none';\n+  }\n+});\n+\n+emailInput.addEventListener('input', function () {\n+  if (emailError.style.display === 'block') {\n+    emailError.style.display = emailRegex.test(this.value) ? 'none' : 'block';\n+  }\n+});\n+\n+form.addEventListener('submit', function (e) {\n+  e.preventDefault();\n+  let valid = true;\n+\n+  if (!emailRegex.test(emailInput.value)) {\n+    emailError.style.display = 'block';\n+    valid = false;\n+  } else {\n+    emailError.style.display = 'none';\n+  }\n+\n+  if (valid) {\n+    formView.style.display = 'none';\n+    thankYouView.style.display = 'block';\n+  }\n+});\n+</script>\n+</body>\n+</html>\n\\ No newline at end of file\n",
  "fdecc0d1afaf6c01a67c9701587dfc31790337f99423ba15e7eb769087204ca2": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>TruthLens</title>\n<style>\n*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }\nbody {\n  font-family: system-ui, -apple-system, sans-serif;\n  min-height: 100vh;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  background: #f4f6f9;\n  color: #1a1a2e;\n  padding: 1.5rem;\n}\n.landing {\n  max-width: 480px;\n  width: 100%;\n  background: #fff;\n  border-radius: 1rem;\n  padding: 2.5rem 2rem;\n  box-shadow: 0 8px 30px rgba(0,0,0,.08);\n}\nh1 {\n  font-size: 1.75rem;\n  font-weight: 700;\n  margin-bottom: .5rem;\n  letter-spacing: -.02em;\n}\np.sub {\n  color: #5b5f6b;\n  margin-bottom: 1.75rem;\n  line-height: 1.5;\n}\n.form-group { margin-bottom: 1.25rem; }\nlabel {\n  display: block;\n  font-weight: 600;\n  font-size: .875rem;\n  margin-bottom: .375rem;\n  color: #2d2d3e;\n}\ninput, textarea {\n  width: 100%;\n  padding: .7rem .85rem;\n  border: 1px solid #d1d5db;\n  border-radius: .5rem;\n  font: inherit;\n  font-size: .9375rem;\n  transition: border .2s, box-shadow .2s;\n}\ninput:focus, textarea:focus {\n  outline: none;\n  border-color: #5b67d4;\n  box-shadow: 0 0 0 3px rgba(91,103,212,.25);\n}\ntextarea { resize: vertical; min-height: 5rem; }\n.error {\n  color: #d7373f;\n  font-size: .8125rem;\n  margin-top: .375rem;\n  display: none;\n}\nbutton {\n  width: 100%;\n  padding: .8rem 1rem;\n  background: #1a1a2e;\n  color: #fff;\n  border: none;\n  border-radius: .5rem;\n  font-weight: 600;\n  font-size: 1rem;\n  cursor: pointer;\n  transition: background .2s;\n}\nbutton:hover { background: #2f2f4a; }\n.thank-you {\n  display: none;\n  text-align: center;\n  padding: 1.5rem 0;\n}\n.thank-you h2 { margin-bottom: .5rem; }\n.thank-you p { color: #5b5f6b; }\n</style>\n</head>\n<body>\n\n<div class=\"landing\">\n  <div id=\"formView\">\n    <h1>Get early access</h1>\n    <p class=\"sub\">Leave your details and we'll reach out when we launch.</p>\n\n    <form id=\"contactForm\" novalidate>\n      <div class=\"form-group\">\n        <label for=\"name\">Name</label>\n        <input type=\"text\" id=\"name\" name=\"name\" required>\n      </div>\n\n      <div class=\"form-group\">\n        <label for=\"email\">Email</label>\n        <input type=\"email\" id=\"email\" name=\"email\" required>\n        <div class=\"error\" id=\"emailError\">Please enter a valid email address.</div>\n      </div>\n\n      <div class=\"form-group\">\n        <label for=\"message\">Message</label>\n        <textarea id=\"message\" name=\"message\" rows=\"3\"></textarea>\n      </div>\n\n      <button type=\"submit\">Submit</button>\n    </form>\n  </div>\n\n  <div class=\"thank-you\" id=\"thankYouView\">\n    <h2>Thank you!</h2>\n    <p>We'll be in touch soon.</p>\n  </div>\n</div>\n\n<script>\nconst emailRegex = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]{2,}$/;\nconst form = document.getElementById('contactForm');\nconst emailInput = document.getElementById('email');\nconst emailError = document.getElementById('emailError');\nconst formView = document.getElementById('formView');\nconst thankYouView = document.getElementById('thankYouView');\n\nemailInput.addEventListener('blur', function () {\n  if (this.value && !emailRegex.test(this.value)) {\n    emailError.style.display = 'block';\n  } else {\n    emailError.style.display = 'none';\n  }\n});\n\nemailInput.addEventListener('input', function () {\n  if (emailError.style.display === 'block') {\n    emailError.style.display = emailRegex.test(this.value) ? 'none' : 'block';\n  }\n});\n\nform.addEventListener('submit', function (e) {\n  e.preventDefault();\n  let valid = true;\n\n  if (!emailRegex.test(emailInput.value)) {\n    emailError.style.display = 'block';\n    valid = false;\n  } else {\n    emailError.style.display = 'none';\n  }\n\n  if (valid) {\n    formView.style.display = 'none';\n    thankYouView.style.display = 'block';\n  }\n});\n</script>\n</body>\n</html>"
