            type="button"
          >
            Timeline
          </button>
        </li>
        <li>
          <button
            class="w-full text-left px-4 py-2 text-sm rounded-lg nav-item "
            type="button"
          >
            Agent Story
          </button>
        </li>
      </ul>
    </nav>
    <main
      class="ml-[220px] p-8 min-h-screen flex-1"
    >
      <div
        class="mb-4 text-sm text-[#8b949e]"
      >
        <span
          class="integrity-badge"
        >
          Hash chain only – HMAC not checked
        </span>
        <p>
          This browser checks the file's internal consistency only; it does not verify signatures.
        </p>
      </div>
      <div>
        <h1
          class="text-4xl font-bold leading-tight mb-2"
        >
          <span
            class="block"
          >
            Your agent said: Done.
          </span>
          <span
            class="block"
          >
            Here's what's actually proven.
          </span>
        </h1>
        <p
          class="text-[#8b949e] text-base mb-4"
        >
          Project: Build a small landing page with a contact form.
        </p>
        <p
          class="text-base mb-6"
        >
          1 met, 1 unmet, 1 unverified
        </p>
        <div
          class="space-y-4"
        >
          <button
            class="card-wrap w-full text-left p-4 "
            style="border-color: rgb(63, 185, 80);"
            type="button"
          >
            <div
              class="flex items-start gap-4"
            >
              <span
                class="icon-circle"
                style="background-color: rgb(63, 185, 80);"
              >
                ✓
              </span>
              <div
                class="flex-1"
              >
                <div
                  class="text-base font-medium"
                >
                  Page exists (index.html with a heading and a form)
                </div>
                <div
                  class="text-[#8b949e] text-sm mt-1"
                >
                  Proven – witnessed evidence passed.
                </div>
                <div
                  class="flex items-center gap-2 mt-2"
                >
                  <span
                    class="text-xs px-[6px] py-[1px] rounded-[4px]"
                    style="color: rgb(63, 185, 80);"
                  >
                    met
                  </span>
                  <span
                    class="text-xs text-[#d29922]"
                  >
                    claimed
                  </span>
                </div>
              </div>
            </div>
          </button>
          <button
            class="card-wrap w-full text-left p-4 "
            style="border-color: rgb(248, 81, 73);"
            type="button"
          >
            <div
              class="flex items-start gap-4"
            >
              <span
                class="icon-circle"
                style="background-color: rgb(248, 81, 73);"
              >
                ✕
              </span>
              <div
                class="flex-1"
              >
                <div
                  class="text-base font-medium"
                >
                  Form validates the e-mail address (invalid input rejected)
                </div>
                <div
                  class="text-[#8b949e] text-sm mt-1"
                >
                  Failed – the witnessed check did not pass.
                </div>
                <div
                  class="flex items-center gap-2 mt-2"
                >
                  <span
                    class="text-xs px-[6px] py-[1px] rounded-[4px]"
                    style="color: rgb(248, 81, 73);"
                  >
                    unmet
                  </span>
                  <span
                    class="text-xs text-[#d29922]"
                  >
                    claimed
                  </span>
                </div>
              </div>
            </div>
          </button>
          <button
            class="card-wrap w-full text-left p-4 "
            style="border-color: rgb(210, 153, 34);"
            type="button"
          >
            <div
              class="flex items-start gap-4"
            >
              <span
                class="icon-circle"
                style="background-color: rgb(210, 153, 34);"
              >
                ?
              </span>
              <div
                class="flex-1"
              >
                <div
                  class="text-base font-medium"
                >
                  Mobile layout works
                </div>
                <div
                  class="text-[#8b949e] text-sm mt-1"
                >
                  Claimed only – nothing checked this yet.
                </div>
                <div
                  class="flex items-center gap-2 mt-2"
                >
                  <span
                    class="text-xs px-[6px] py-[1px] rounded-[4px]"
                    style="color: rgb(210, 153, 34);"
                  >
                    unverified
                  </span>
                  <span
                    class="text-xs text-[#d29922]"
                  >
                    claimed
                  </span>
                </div>
              </div>
            </div>
          </button>
        </div>
        <div
          class="callout-wrap mt-8"
        >
          <p
            class="text-sm text-[#e6edf3]"
          >
            Your agent said ‘The form validates the e-mail address using a regex and shows an error’. Not everything in it was proven.
          </p>
        </div>
      </div>
    </main>
  </div>
</DocumentFragment>
`;

