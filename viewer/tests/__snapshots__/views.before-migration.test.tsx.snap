exports[`pre-migration viewer snapshots (must remain unchanged) > Claimed vs Proven, client lens, real public/run.json 1`] = `
<DocumentFragment>
  <div
    class="app-shell"
  >
    <a
      class="skip-link"
      href="#main-content"
    >
      Zum Inhalt
    </a>
    <header
      class="mountain-header"
    >
      <div
        class="brand"
      >
        <img
          alt=""
          height="64"
          src="/truthlens-mark.svg"
          width="64"
        />
        <div>
          <span
            class="brand-name"
          >
            TruthLens
          </span>
          <p>
            Sieh, was dein Agent wirklich getan hat.
          </p>
        </div>
      </div>
      <p
        class="brand-note"
      >
        Belege statt Behauptungen.
      </p>
    </header>
    <div
      class="workspace"
    >
      <nav
        aria-label="Viewer navigation"
        class="sidebar"
      >
        <ul
          class="nav-list"
        >
          <li>
            <button
              class="nav-item "
              type="button"
            >
              <svg
                aria-hidden="true"
                class="lucide lucide-layout-dashboard"
                fill="none"
                height="18"
                stroke="currentColor"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                viewBox="0 0 24 24"
                width="18"
                xmlns="http://www.w3.org/2000/svg"
              >
                <rect
                  height="9"
                  rx="1"
                  width="7"
                  x="3"
                  y="3"
                />
                <rect
                  height="5"
                  rx="1"
                  width="7"
                  x="14"
                  y="3"
                />
                <rect
                  height="9"
                  rx="1"
                  width="7"
                  x="14"
                  y="12"
                />
                <rect
                  height="5"
                  rx="1"
                  width="7"
                  x="3"
                  y="16"
                />
              </svg>
              <span>
                Overview
              </span>
            </button>
          </li>
          <li>
            <button
              aria-current="page"
              class="nav-item nav-item-active"
              type="button"
            >
              <svg
                aria-hidden="true"
                class="lucide lucide-list-checks"
                fill="none"
                height="18"
                stroke="currentColor"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                viewBox="0 0 24 24"
                width="18"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path
                  d="M13 5h8"
                />
                <path
                  d="M13 12h8"
                />
                <path
                  d="M13 19h8"
                />
                <path
                  d="m3 17 2 2 4-4"
                />
                <path
                  d="m3 7 2 2 4-4"
                />
              </svg>
              <span>
                Claimed vs Proven
              </span>
            </button>
          </li>
          <li>
            <button
              class="nav-item "
              type="button"
            >
              <svg
                aria-hidden="true"
                class="lucide lucide-list-tree"
                fill="none"
                height="18"
                stroke="currentColor"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                viewBox="0 0 24 24"
                width="18"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path
                  d="M8 5h13"
                />
                <path
                  d="M13 12h8"
                />
                <path
                  d="M13 19h8"
                />
                <path
                  d="M3 10a2 2 0 0 0 2 2h3"
                />
                <path
                  d="M3 5v12a2 2 0 0 0 2 2h3"
                />
              </svg>
              <span>
                Timeline
              </span>
            </button>
          </li>
          <li>
            <button
              class="nav-item "
              type="button"
            >
              <svg
                aria-hidden="true"
                class="lucide lucide-route"
                fill="none"
                height="18"
                stroke="currentColor"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                viewBox="0 0 24 24"
                width="18"
                xmlns="http://www.w3.org/2000/svg"
              >
                <circle
                  cx="6"
                  cy="19"
                  r="3"
                />
                <path
                  d="M9 19h8.5a3.5 3.5 0 0 0 0-7h-11a3.5 3.5 0 0 1 0-7H15"
                />
                <circle
                  cx="18"
                  cy="5"
                  r="3"
                />
              </svg>
              <span>
                Agent Story
              </span>
            </button>
          </li>
        </ul>
        <div
          class="sidebar-meta"
        >
          <div
            aria-label="View lens"
            class="lens-toggle"
            role="group"
          >
            <button
              aria-pressed="true"
              type="button"
            >
              Client
            </button>
            <button
              aria-pressed="false"
              type="button"
            >
              Developer
            </button>
          </div>
          <span
            class="inline-flex w-fit items-center gap-1 rounded-md border px-2 py-1 text-xs font-medium border-border text-foreground"
            data-slot="badge"
          >
            Review required
          </span>
          <p>
            Lokaler RunDoc-Export.
            <br />
            Keine fachliche Freigabe im Browser.
          </p>
        </div>
      </nav>
      <main
        id="main-content"
        tabindex="-1"
      >
        <aside
          aria-label="Trust boundaries"
          class="integrity-notice"
        >
          <div
            class="integrity-level"
          >
            <span
              class="integrity-badge"
            >
              <span
                class="inline-flex w-fit items-center gap-1 rounded-md border px-2 py-1 text-xs font-medium border-warning/40 bg-warning/10 text-warning"
                data-slot="status-badge"
                data-variant="nur-hash"
              >
                <span>
                  Nur Hash · HMAC nicht geprüft
                </span>
              </span>
            </span>
            <strong>
              Integrität ≠ fachliche Freigabe
            </strong>
          </div>
          <p>
            This browser checks the file's internal consistency only; it does not verify signatures.
          </p>
        </aside>
        <section>
          <h1
            class="text-2xl font-bold mb-6"
          >
            What your agent said
          </h1>
          <div
            class="space-y-4"
          >
            <article
              class="card-wrap border-border p-4"
            >
              <p
                class="text-base mb-3 break-words"
              >
                <span
                  class="text-muted-foreground mr-1"
                >
                  Agent said
                </span>
                “Created index.html with a page that has a heading and a contact form”
              </p>
              <span
                class="inline-flex w-fit items-center gap-1 rounded-md border px-2 py-1 text-xs font-medium border-warning/40 bg-warning/10 text-warning"
                data-slot="status-badge"
                data-variant="offen"
              >
                <span>
                  Claim · supported
                </span>
              </span>
            </article>
            <article
              class="card-wrap border-border p-4"
            >
              <p
                class="text-base mb-3 break-words"
              >
                <span
                  class="text-muted-foreground mr-1"
                >
                  Agent said
                </span>
                “The form validates the e-mail address using a regex and shows an error”
              </p>
              <span
                class="inline-flex w-fit items-center gap-1 rounded-md border px-2 py-1 text-xs font-medium border-warning/40 bg-warning/10 text-warning"
                data-slot="status-badge"
                data-variant="offen"
              >
                <span>
                  Claim · claim_unwitnessed
                </span>
              </span>
            </article>
            <article
              class="card-wrap border-border p-4"
            >
              <p
                class="text-base mb-3 break-words"
              >
                <span
                  class="text-muted-foreground mr-1"
                >
                  Agent said
                </span>
                “The page uses a fluid max-width container so it works on mobile”
              </p>
              <span
                class="inline-flex w-fit items-center gap-1 rounded-md border px-2 py-1 text-xs font-medium border-warning/40 bg-warning/10 text-warning"
                data-slot="status-badge"
                data-variant="offen"
              >
                <span>
                  Claim · claim_unwitnessed
                </span>
              </span>
            </article>
          </div>
        </section>
      </main>
    </div>
  </div>
</DocumentFragment>
`;

