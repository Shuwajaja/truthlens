                  &lt;!DOCTYPE html&gt;
&lt;html lang="en"&gt;
&lt;head&gt;
  &lt;meta charset="UTF-8"&gt;
  &lt;meta name="viewport" content="width=device-width, initial-scale=1.0"&gt;
  &lt;title&gt;Acme — Contact Us&lt;/title&gt;
  &lt;style&gt;
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: system-ui, -apple-system, Segoe UI, Roboto, sans-serif;
      line-height: 1.6;
      color: #1f2430;
      background: #f6f7fb;
    }
    .wrap { max-width: 720px; margin: 0 auto; padding: 2rem 1.5rem; }
    header { text-align: center; padding: 3rem 1rem 1.5rem; }
    header h1 { font-size: 2.4rem; color: #0d1b2a; }
    header p { color: #5a6270; margin-top: 0.5rem; }
    form {
      background: #fff;
      border: 1px solid #e4e7ee;
      border-radius: 12px;
      padding: 1.75rem;
      box-shadow: 0 8px 24px rgba(0,0,0,0.06);
      display: flex;
      flex-direction: column;
      gap: 1.1rem;
    }
    label { font-weight: 600; font-size: 0.95rem; margin-bottom: 0.3rem; display: block; }
    input, textarea {
      width: 100%;
      padding: 0.7rem 0.8rem;
      border: 1px solid #cdd2dd;
      border-radius: 8px;
      font: inherit;
    }
    input:focus, textarea:focus {
      outline: none;
      border-color: #2563eb;
      box-shadow: 0 0 0 3px rgba(37,99,235,0.15);
    }
    .error { color: #dc2626; font-size: 0.85rem; display: none; }
    .field.invalid input, .field.invalid textarea { border-color: #dc2626; }
    .field.invalid .error { display: block; }
    button {
      background: #2563eb;
      color: #fff;
      border: none;
      padding: 0.8rem 1.2rem;
      border-radius: 8px;
      font-size: 1rem;
      font-weight: 600;
      cursor: pointer;
      transition: background 0.15s;
    }
    button:hover { background: #1d4ed8; }
    .success {
      display: none;
      background: #ecfdf5;
      border: 1px solid #34d399;
      color: #065f46;
      border-radius: 8px;
      padding: 0.9rem 1rem;
      margin-top: 1rem;
    }
  &lt;/style&gt;
&lt;/head&gt;
&lt;body&gt;
  &lt;header&gt;
    &lt;h1&gt;Get in touch&lt;/h1&gt;
    &lt;p&gt;Tell us a little about your project and we'll get back to you within a day.&lt;/p&gt;
  &lt;/header&gt;

  &lt;main class="wrap"&gt;
    &lt;form id="contactForm" novalidate&gt;
      &lt;div class="field"&gt;
        &lt;label for="name"&gt;Name&lt;/label&gt;
        &lt;input type="text" id="name" name="name" autocomplete="name"&gt;
      &lt;/div&gt;
      &lt;div class="field"&gt;
        &lt;label for="email"&gt;Email&lt;/label&gt;
        &lt;input type="email" id="email" name="email" autocomplete="email"&gt;
        &lt;span class="error"&gt;Please enter a valid email address.&lt;/span&gt;
      &lt;/div&gt;
      &lt;div class="field"&gt;
        &lt;label for="message"&gt;Message&lt;/label&gt;
        &lt;textarea id="message" name="message" rows="5"&gt;&lt;/textarea&gt;
      &lt;/div&gt;
      &lt;button type="submit"&gt;Send message&lt;/button&gt;
    &lt;/form&gt;
    &lt;div class="success" id="success"&gt;Thanks! Your message has been sent.&lt;/div&gt;
  &lt;/main&gt;

  &lt;script&gt;
    const form = document.getElementById('contactForm');
    const email = document.getElementById('email');
    const emailField = email.closest('.field');
    const success = document.getElementById('success');
    const emailRegex = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;

    form.addEventListener('submit', (e) =&gt; {
      e.preventDefault();
      success.style.display = 'none';
      emailField.classList.remove('invalid');

      let valid = true;
      if (!emailRegex.test(email.value.trim())) {
        emailField.classList.add('invalid');
        valid = false;
      }
      if (valid) success.style.display = 'block';
    });

    email.addEventListener('input', () =&gt; emailField.classList.remove('invalid'));
  &lt;/script&gt;
&lt;/body&gt;
&lt;/html&gt;

