+<!DOCTYPE html>
+<html lang="en">
+<head>
+<meta charset="UTF-8">
+<meta name="viewport" content="width=device-width, initial-scale=1.0">
+<title>TruthLens</title>
+<style>
+*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
+body {
+  font-family: system-ui, -apple-system, sans-serif;
+  min-height: 100vh;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  background: #f4f6f9;
+  color: #1a1a2e;
+  padding: 1.5rem;
+}
+.landing {
+  max-width: 480px;
+  width: 100%;
+  background: #fff;
+  border-radius: 1rem;
+  padding: 2.5rem 2rem;
+  box-shadow: 0 8px 30px rgba(0,0,0,.08);
+}
+h1 {
+  font-size: 1.75rem;
+  font-weight: 700;
+  margin-bottom: .5rem;
+  letter-spacing: -.02em;
+}
+p.sub {
+  color: #5b5f6b;
+  margin-bottom: 1.75rem;
+  line-height: 1.5;
+}
+.form-group { margin-bottom: 1.25rem; }
+label {
+  display: block;
+  font-weight: 600;
+  font-size: .875rem;
+  margin-bottom: .375rem;
+  color: #2d2d3e;
+}
+input, textarea {
+  width: 100%;
+  padding: .7rem .85rem;
+  border: 1px solid #d1d5db;
+  border-radius: .5rem;
+  font: inherit;
+  font-size: .9375rem;
+  transition: border .2s, box-shadow .2s;
+}
+input:focus, textarea:focus {
+  outline: none;
+  border-color: #5b67d4;
+  box-shadow: 0 0 0 3px rgba(91,103,212,.25);
+}
+textarea { resize: vertical; min-height: 5rem; }
+.error {
+  color: #d7373f;
+  font-size: .8125rem;
+  margin-top: .375rem;
+  display: none;
+}
+button {
+  width: 100%;
+  padding: .8rem 1rem;
+  background: #1a1a2e;
+  color: #fff;
+  border: none;
+  border-radius: .5rem;
+  font-weight: 600;
+  font-size: 1rem;
+  cursor: pointer;
+  transition: background .2s;
+}
+button:hover { background: #2f2f4a; }
+.thank-you {
+  display: none;
+  text-align: center;
+  padding: 1.5rem 0;
+}
+.thank-you h2 { margin-bottom: .5rem; }
+.thank-you p { color: #5b5f6b; }
+</style>
+</head>
+<body>
+
+<div class="landing">
+  <div id="formView">
+    <h1>Get early access</h1>
+    <p class="sub">Leave your details and we'll reach out when we launch.</p>
+
+    <form id="contactForm" novalidate>
+      <div class="form-group">
+        <label for="name">Name</label>
+        <input type="text" id="name" name="name" required>
+      </div>
+
+      <div class="form-group">
+        <label for="email">Email</label>
+        <input type="email" id="email" name="email" required>
+        <div class="error" id="emailError">Please enter a valid email address.</div>
+      </div>
+
+      <div class="form-group">
+        <label for="message">Message</label>
+        <textarea id="message" name="message" rows="3"></textarea>
+      </div>
+
+      <button type="submit">Submit</button>
+    </form>
+  </div>
+
+  <div class="thank-you" id="thankYouView">
+    <h2>Thank you!</h2>
+    <p>We'll be in touch soon.</p>
+  </div>
+</div>
+
+<script>
+const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;
+const form = document.getElementById('contactForm');
+const emailInput = document.getElementById('email');
+const emailError = document.getElementById('emailError');
+const formView = document.getElementById('formView');
+const thankYouView = document.getElementById('thankYouView');
+
+emailInput.addEventListener('blur', function () {
+  if (this.value && !emailRegex.test(this.value)) {
+    emailError.style.display = 'block';
+  } else {
+    emailError.style.display = 'none';
+  }
+});
+
+emailInput.addEventListener('input', function () {
+  if (emailError.style.display === 'block') {
+    emailError.style.display = emailRegex.test(this.value) ? 'none' : 'block';
+  }
+});
+
+form.addEventListener('submit', function (e) {
+  e.preventDefault();
+  let valid = true;
+
+  if (!emailRegex.test(emailInput.value)) {
+    emailError.style.display = 'block';
+    valid = false;
+  } else {
+    emailError.style.display = 'none';
+  }
+
+  if (valid) {
+    formView.style.display = 'none';
+    thankYouView.style.display = 'block';
+  }
+});
+</script>
+</body>
+</html>
